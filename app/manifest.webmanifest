{
  "name": "Loop Studio",
  "short_name": "Studio",
  "description": "Briefs, builds and the Library, in one place.",
  "id": "/app/",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "__BG_LIGHT__",
  "theme_color": "__BG_LIGHT__",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-mask.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/app/#/today", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Builds", "url": "/app/#/builds", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
